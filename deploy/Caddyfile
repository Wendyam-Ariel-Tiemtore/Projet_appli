# Proxy HTTPS devant l'application.
# - SITE_ADDRESS=localhost et TLS_MODE=internal : certificat d'une autorité locale (usage sur la machine).
# - SITE_ADDRESS=analyse.mon-domaine.org et TLS_MODE=adresse@mail : certificat Let's Encrypt automatique.
# L'adresse https://127.0.0.1 est aussi servie, avec un certificat de l'autorité locale : un navigateur
# n'envoie pas de nom de serveur (SNI) pour une adresse IP, d'où le réglage default_sni ci-dessous.
{
	admin off
	default_sni 127.0.0.1
	servers {
		protocols h1 h2
	}
}

(application) {
	encode zstd gzip
	request_body {
		max_size 64MB
	}
	# Les en-têtes de sécurité (CSP, HSTS avec sous-domaines, etc.) sont posés par l'application elle-même.
	header {
		-Server
		-Via
	}
	reverse_proxy app:8000 {
		header_up X-Forwarded-Proto https
		transport http {
			response_header_timeout 120s
		}
	}
	# Caddy masque par défaut les en-têtes sensibles (Cookie, Authorization) dans ses journaux.
	log {
		output stdout
		format console
	}
}

{$SITE_ADDRESS:localhost} {
	tls {$TLS_MODE:internal}
	import application
}

https://127.0.0.1 {
	tls internal
	import application
}
