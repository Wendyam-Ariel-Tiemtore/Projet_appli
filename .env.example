# Copier ce fichier en « .env » puis adapter. Ne jamais publier le fichier .env.

# --- Adresse et certificat ---------------------------------------------------
# Usage sur votre ordinateur : laisser tel quel, puis ouvrir https://localhost
SITE_ADDRESS=localhost
TLS_MODE=internal
BIND_ADDRESS=127.0.0.1
# Serveur avec nom de domaine (certificat Let's Encrypt automatique) :
# SITE_ADDRESS=analyse.mon-domaine.org
# TLS_MODE=vous@mon-domaine.org
# BIND_ADDRESS=0.0.0.0
# ANALYSTE_ALLOWED_HOSTS=["analyse.mon-domaine.org","127.0.0.1"]   (127.0.0.1 : contrôle de santé interne)

# --- Comptes et conservation --------------------------------------------------
# Sur un serveur, définir un code secret exigé pour créer le compte administrateur :
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
ANALYSTE_SETUP_TOKEN=
ANALYSTE_REGISTRATION_OPEN=false
ANALYSTE_RETENTION_DAYS=7
ANALYSTE_MAX_UPLOAD_MB=50
ANALYSTE_SESSION_IDLE_MINUTES=30

# --- Rédaction assistée --------------------------------------------------------
# Modèle local (profil docker « ia-locale ») : rien ne quitte la machine
ANALYSTE_OLLAMA_MODEL=qwen2.5:14b-instruct
# Claude (API Anthropic) : chaque utilisateur peut aussi saisir sa propre clé dans Paramètres
ANALYSTE_ALLOW_EXTERNAL_LLM=true
ANALYSTE_ANTHROPIC_MODEL=claude-sonnet-5-5
ANALYSTE_ANTHROPIC_API_KEY=

# --- Littérature ----------------------------------------------------------------
ANALYSTE_ALLOW_LITERATURE=true
ANALYSTE_OPENALEX_API_KEY=
ANALYSTE_OPENALEX_MAILTO=

# --- Calcul ---------------------------------------------------------------------
ANALYSTE_WORKER_THREADS=2
